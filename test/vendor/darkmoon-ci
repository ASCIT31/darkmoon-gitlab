#!/usr/bin/env python3
"""darkmoon-ci — CONTRACT-FAITHFUL TEST DOUBLE (E2E harness only).

This is NOT the product CLI. The real, portable `darkmoon-ci` is built and
shipped separately (see the darkmoon-client task). This double implements the
frozen contract in CONTRACT.md exactly — same flags, same native
`darkmoon-findings.json` schema, same exit codes — so the GitLab component can be
exercised end-to-end by a real GitLab Runner against genuine Darkmoon engine
output.

Sources of findings, in order:
  1. --mode pro  : GET {base-url}/v1/findings?target=...  (real Pro REST call)
  2. env DARKMOON_CI_REPLAY=<report.md> : parse a genuine Darkmoon markdown
     report produced by the OSS/Pro engine (used by the offline E2E).
  3. --mode oss  : drive the local engine via darkmoon.sh (best-effort) and
     parse the emitted report.

Whatever the source, the OUTPUT is the frozen native JSON, and secrets are read
only from the environment and never printed.
"""
from __future__ import annotations

import argparse
import datetime as dt
import json
import os
import re
import sys

SEV_ORDER = ["info", "low", "medium", "high", "critical"]
SEV_RANK = {s: i for i, s in enumerate(SEV_ORDER)}

# usage=2, runtime=3, gate=4, auth=5, clean=0  (per CONTRACT.md §1.2)
EX_OK, EX_USAGE, EX_RUNTIME, EX_GATE, EX_AUTH = 0, 2, 3, 4, 5

CATEGORY_RULES = [
    ("sqli", r"sql injection|sqli"),
    ("xss", r"\bxss\b|cross.site scripting"),
    ("ssrf", r"\bssrf\b|server.side request"),
    ("rce", r"\brce\b|remote code|command execution"),
    ("secret-exposure", r"secret|token|access key|credential|password|pat\b"),
    ("auth", r"authentication|2fa|two.factor|self.registration|admin mode|login"),
    ("idor", r"\bidor\b|insecure direct object"),
    ("info-disclosure", r"information disclosure|version.*disclosure|verbose"),
    ("rate-limiting", r"rate limit|brute.force"),
    ("branch-protection", r"branch protection"),
    ("misconfiguration", r"misconfig|enabled|disabled|policy|registry|auto devops|hooks"),
]
CWE_BY_CAT = {
    "sqli": ("CWE-89", "A03:2021-Injection"),
    "xss": ("CWE-79", "A03:2021-Injection"),
    "ssrf": ("CWE-918", "A10:2021-SSRF"),
    "rce": ("CWE-94", "A03:2021-Injection"),
    "secret-exposure": ("CWE-522", "A07:2021-Identification and Authentication Failures"),
    "auth": ("CWE-287", "A07:2021-Identification and Authentication Failures"),
    "idor": ("CWE-639", "A01:2021-Broken Access Control"),
    "info-disclosure": ("CWE-200", "A05:2021-Security Misconfiguration"),
    "rate-limiting": ("CWE-770", "A04:2021-Insecure Design"),
    "branch-protection": ("CWE-284", "A01:2021-Broken Access Control"),
    "misconfiguration": ("CWE-16", "A05:2021-Security Misconfiguration"),
}


def _now():
    return dt.datetime.now(dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def infer_category(title):
    t = title.lower()
    for cat, pat in CATEGORY_RULES:
        if re.search(pat, t):
            return cat
    return "finding"


def strip_host(endpoint):
    """Return a redaction-safe URL PATH (host:port removed) for location.path."""
    e = endpoint.strip().strip("`")
    e = re.sub(r"^[a-zA-Z]+://", "", e)          # scheme
    e = re.sub(r"^[^/]+", "", e)                  # host[:port]
    e = e.strip("/")
    e = e.replace("...", "")
    return e or ".darkmoon/report.md"


def parse_report(path):
    with open(path, "r", encoding="utf-8", errors="replace") as fh:
        text = fh.read()

    # Full titles from the detail section headers (### 3.N — <title>), in order.
    detail_titles = re.findall(r"^###\s+3\.\d+\s+—\s+(.+?)\s*$", text, re.M)

    findings = []
    row_re = re.compile(
        r"^\|\s*\d+\s*\|\s*`?([^|`]+?)`?\s*\|\s*(.+?)\s*\|\s*"
        r"(CRITICAL|HIGH|MEDIUM|LOW|INFO)\s*\|\s*([^|]+?)\s*\|\s*(.+?)\s*\|\s*(.+?)\s*\|\s*$",
        re.M | re.I,
    )
    for i, m in enumerate(row_re.finditer(text)):
        vid, title_tbl, sev, cvss, status, endpoint = m.groups()
        title = detail_titles[i] if i < len(detail_titles) else title_tbl.strip().rstrip(".")
        title = title.replace("...", "").strip()
        sev = sev.lower()
        category = infer_category(title)
        cwe, owasp = CWE_BY_CAT.get(category, ("CWE-693", "A05:2021-Security Misconfiguration"))
        try:
            cvss_v = float(cvss)
        except ValueError:
            cvss_v = None
        path_loc = strip_host(endpoint)
        findings.append({
            "id": vid.strip(),
            "title": title[:255],
            "severity": sev,
            "category": category,
            # summary is redaction-safe: the generic title only, no host/infra.
            "summary": title[:255],
            "description": "See the full Darkmoon report artifact (internal).",
            "evidence": "Withheld from shared surfaces (threat model §4).",
            "location": {"path": path_loc, "line": 1, "url": None},
            "cwe": cwe,
            "owasp": owasp,
            "cvss": cvss_v,
            "confidence": "confirmed",
            "status": (status or "").strip().strip("*").lower() or "reported",
            "remediation": "See remediation guidance in the full report.",
        })
    return findings


def pro_findings(base_url, target, timeout):
    """Real Pro REST call. Token from env, never argv/logs."""
    import urllib.request
    token = os.environ.get("DARKMOON_API_TOKEN") or ""
    if not token:
        sys.stderr.write("[darkmoon-ci] no DARKMOON_API_TOKEN for pro mode\n")
        raise SystemExit(EX_AUTH)
    url = base_url.rstrip("/") + "/v1/findings?target=" + urllib.parse.quote(target)
    req = urllib.request.Request(url, headers={"Authorization": "Bearer " + token})
    try:
        with urllib.request.urlopen(req, timeout=timeout or 60) as r:
            payload = json.loads(r.read().decode("utf-8"))
    except Exception as exc:  # noqa: BLE001
        sys.stderr.write("[darkmoon-ci] pro API call failed: %s\n" % exc)
        raise SystemExit(EX_RUNTIME)
    return payload.get("findings", payload if isinstance(payload, list) else [])


def gate(findings, fail_on):
    if fail_on == "none":
        return False
    thresh = SEV_RANK.get(fail_on, SEV_RANK["high"])
    return any(SEV_RANK.get(f.get("severity", "info"), 0) >= thresh for f in findings)


def build_doc(findings, args, edition):
    counts = {s: 0 for s in SEV_ORDER}
    for f in findings:
        counts[f.get("severity", "info")] = counts.get(f.get("severity", "info"), 0) + 1
    tripped = gate(findings, args.fail_on)
    # redaction-safe target label: strip scheme/host to a bare label
    label = re.sub(r"^[a-zA-Z]+://", "", args.target).split("/")[0]
    return {
        "schema_version": "contract/1.0",
        "tool": {"name": "darkmoon-ci", "version": "1.4.0-e2e", "edition": edition},
        "mode": edition,
        "target": label,
        "started_at": _now(),
        "generated_at": _now(),
        "severity_cap": args.severity or "critical",
        "fail_on": args.fail_on,
        "summary": {"total": len(findings), "by_severity": counts,
                    "gate": args.fail_on, "gate_tripped": tripped},
        "findings": findings,
    }


def cmd_scan(args):
    replay = os.environ.get("DARKMOON_CI_REPLAY")
    edition = args.mode
    if args.mode == "auto":
        edition = "pro" if (os.environ.get("DARKMOON_API_TOKEN") and args.base_url) else "oss"

    if edition == "pro" and not replay:
        findings = pro_findings(args.base_url, args.target, args.timeout)
    elif replay:
        if not os.path.isfile(replay):
            sys.stderr.write("[darkmoon-ci] replay report not found: %s\n" % replay)
            return EX_RUNTIME
        findings = parse_report(replay)
        edition = "oss"
    else:
        # live OSS path (best-effort, environment-specific)
        sys.stderr.write("[darkmoon-ci] no DARKMOON_CI_REPLAY set and live OSS run "
                         "not wired in this double; provide a report to replay.\n")
        return EX_RUNTIME

    # apply severity cap
    if args.severity:
        cap = SEV_RANK.get(args.severity, SEV_RANK["critical"])
        for f in findings:
            if SEV_RANK.get(f.get("severity", "info"), 0) > cap:
                f["severity"] = args.severity

    os.makedirs(args.output_dir, exist_ok=True)
    doc = build_doc(findings, args, edition)
    with open(os.path.join(args.output_dir, "darkmoon-findings.json"), "w", encoding="utf-8") as fh:
        json.dump(doc, fh, indent=2, ensure_ascii=False)
    # a plain (internal) markdown artifact
    with open(os.path.join(args.output_dir, "darkmoon-report.md"), "w", encoding="utf-8") as fh:
        fh.write("# Darkmoon report (internal)\n\n%d findings. Full detail withheld "
                 "from shared surfaces per threat model.\n" % len(findings))

    sys.stderr.write("[darkmoon-ci] %d findings; gate(%s) tripped=%s\n"
                     % (len(findings), args.fail_on, doc["summary"]["gate_tripped"]))
    return EX_GATE if doc["summary"]["gate_tripped"] else EX_OK


def main(argv):
    ap = argparse.ArgumentParser(prog="darkmoon-ci", add_help=True)
    sub = ap.add_subparsers(dest="cmd")
    sc = sub.add_parser("scan")
    sc.add_argument("--mode", default="auto", choices=["auto", "oss", "pro"])
    sc.add_argument("--target", required=True)
    sc.add_argument("--base-url", dest="base_url", default="")
    sc.add_argument("--focus", default="")
    sc.add_argument("--severity", default="", choices=["", "info", "low", "medium", "high", "critical"])
    sc.add_argument("--fail-on", dest="fail_on", default="high",
                    choices=["none", "info", "low", "medium", "high", "critical"])
    sc.add_argument("--output-dir", dest="output_dir", default="darkmoon")
    sc.add_argument("--format", default="json,markdown")
    sc.add_argument("--redact", action="store_true")
    sc.add_argument("--no-redact", dest="redact", action="store_false")
    sc.add_argument("--timeout", type=int, default=0)
    sc.add_argument("--quiet", action="store_true")
    try:
        args = ap.parse_args(argv)
    except SystemExit:
        return EX_USAGE
    if args.cmd != "scan":
        ap.print_help(sys.stderr)
        return EX_USAGE
    return cmd_scan(args)


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
